# ==============================================================================
# Vector MCP Environment Configuration
# ==============================================================================

# --- MCP Server Settings ---
HOST=127.0.0.1
PORT=8000
TRANSPORT=stdio # options: stdio, streamable-http, sse

# --- Telemetry and observability ---
ENABLE_OTEL=
# Configure the shared AgentConfig observability profile and runtime secret
# references. Content capture remains disabled unless governance explicitly enables it.

# --- Embedding model registry ---
# Configure AgentConfig EMBEDDING_MODELS and its referenced runtime credentials.

# --- Vector store ---
# Required only for filesystem ingestion. Supply the operator-owned root at runtime.
DOCUMENT_DIRECTORY=
# Backend used when db_type is unspecified. Default is the native epistemic-graph
# engine (local, zero-infra, durable). Options: epistemic_graph, postgres, mongodb,
# qdrant. DATABASE_TYPE is the canonical variable; VECTOR_DB_TYPE is accepted as an
# alias for backward compatibility.
DATABASE_TYPE=epistemic_graph
# VECTOR_DB_TYPE=epistemic_graph
# The native engine's transport and authentication are resolved entirely by
# AgentConfig / the epistemic-graph client. Do not persist them in this file.

# --- Postgres / MongoDB / Qdrant opt-in providers ---
# Only required when DATABASE_TYPE selects one of these. Credentials are secret
# references (secret://, vault://, env://), never literal values.
DB_HOST= # postgres/qdrant host
DBNAME= # postgres/mongodb database name
QDRANT_HTTP_ALLOWED_PRIVATE_HOSTS= # comma-separated SSRF allowlist for a private Qdrant host

# --- Tool Toggle Switches ---
COLLECTION_MANAGEMENTTOOL=True
SEARCHTOOL=True

# --- Container image references (docker/mcp.compose.yml, docker/agent.compose.yml) ---
# Both are required, immutable digest references — no default is provided.
VECTOR_MCP_MCP_IMAGE=  # e.g. registry.example.invalid/vector-mcp@sha256:<digest>
VECTOR_MCP_DATA_DIR=
SPLIT_ACTIONTOOL=True
VECTOR_ENGINE_SCOPES=
