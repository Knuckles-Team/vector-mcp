# ==============================================================================
# tests/test_all_backends.py connection settings
# ==============================================================================
# Client-side connection info for the integration test suite ONLY — it configures
# how the *tests* reach the throwaway database containers started by
# ../docker/compose.test.yml (see ../docker/test-db.env for those containers' own
# bootstrap credentials). Never read by the shipped vector_mcp package, so it is
# deliberately kept out of the top-level .env.example (the deployable app config
# surface) and out of docker/compose.test.yml's `environment:` block.
#
# Usage: copy the values you need into your shell (or a local, git-ignored
# `tests/.env`) before running `pytest tests/test_all_backends.py -v`. Defaults
# below match docker/compose.test.yml + docker/test-db.env as shipped.

TEST_POSTGRES_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/vectordb
TEST_MONGODB_HOST=localhost
TEST_MONGODB_PORT=27017
TEST_MONGODB_DB=vectordb
TEST_QDRANT_LOCATION=http://localhost:6333
TEST_COUCHBASE_CONNECTION=couchbase://localhost
TEST_COUCHBASE_USER=Administrator
TEST_COUCHBASE_PASSWORD=password
TEST_COUCHBASE_DB=vector_db
