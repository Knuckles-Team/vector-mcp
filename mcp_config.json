{
  "mcpServers": {
    "vector-mcp": {
      "command": "uv",
      "args": [
        "run",
        "vector-mcp"
      ],
      "env": {
        "COLLECTION_MANAGEMENTTOOL": "True",
        "DATABASE_TYPE": "medulla",
        "SEARCHTOOL": "True",
        "VECTOR_DB_TYPE": "medulla"
      }
    }
  }
}
